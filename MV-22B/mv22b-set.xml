<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList include="Systems/v22-base.xml">

  <sim>

    <description>Bell Boeing MV-22B Osprey (JSBSim)</description>
    <authors>
      <author    n="0">
        <name>JSBSim flight model from NASA's XV-15 data and the V-22's published data</name>
      </author>
      <author    n="1">
        <name>BARANGER Emmanuel (3D model, systems)</name>
      </author>
      <author    n="2">
        <name>Maik Justus (animations, the original YASim model)</name>
      </author>
      <author    n="3">
        <name>Oliver Thurau (3D upgrade)</name>
      </author>
      <author    n="4">
        <name>Paolo AMOROSO (3D details)</name>
      </author>
    </authors>

    <long-description>The MV-22B tiltrotor with a JSBSim flight model built from NASA's XV-15 data and the V-22's
      published rotor, wing and performance data: two gimballed proprotors simulated blade by blade under a dynamic
      inflow, the nacelles tilting at the conversion rate within the conversion protection's corridor, the wing in the
      rotors' wakes, the interconnected drive with its torque limit and the collective governor.</long-description>

    <aircraft-version>2.0</aircraft-version>
    <!-- by the FlightGear wiki's criteria (the ratings below); early-production needs at least 3 in each -->
    <status>beta</status>
    <minimum-fg-version>2024.2.0</minimum-fg-version>

    <!-- for the launcher of FlightGear 2024.2 and later, whose only renderer is HDR: the model's shading (the pbr
         animation, Effects/Bump), exterior lights (light/HDR) and glass (the model's HDR glazing) work there -->
    <compatibility>
      <pbr-model type="bool">true</pbr-model>
    </compatibility>

    <!-- the JSBSim model, generated by fdm/genv22.py (the YASim model it replaces is kept as Systems/v22-yasim.xml) -->
    <flight-model>jsb</flight-model>
    <aero>mv22b</aero>
    <!-- the rotors' gimbals and inflow are integrated at the flight model's rate -->
    <model-hz type="int">480</model-hz>

    <rating>
      <FDM      type="int"> 4 </FDM>
      <systems  type="int"> 2 </systems>
      <cockpit  type="int"> 2 </cockpit>
      <model    type="int"> 4 </model>
    </rating>

    <!-- the loading screen: a line on the flight model, above the loading status (FlightGear's own lines are
         /sim/startup/content[1-8], defaults.xml) -->
    <startup>
      <content n="9">
        <name>flight-model</name>
        <text>JSBSim flight model: both proprotors simulated blade by blade on their gimbals, built from NASA's XV-15 data and checked against the XV-15's and the V-22's tests</text>
        <font>
          <size>0.024</size>
          <alignment>right-bottom</alignment>
          <face>Fonts/LiberationFonts/LiberationSans-BoldItalic.ttf</face>
        </font>
        <max-width>0.42</max-width>
        <max-line-count>3</max-line-count>
        <x>0.975</x>
        <y>0.885</y>
      </content>
    </startup>

    <previews>
      <preview>
        <type>interior</type>
        <splash type="bool">true</splash>
        <path>Previews/v22-0.png</path>
      </preview>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Previews/v22-1.png</path>
      </preview>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Previews/v22-2.png</path>
      </preview>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Previews/v22-3.png</path>
      </preview>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Previews/v22-4.png</path>
      </preview>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Previews/v22-5.png</path>
      </preview>
    </previews>

    <tags>
      <tag>bell</tag>
      <tag>boeing</tag>
      <tag>vtol</tag>
      <tag>transport</tag>
      <tag>1990s</tag>
      <tag>2000s</tag>
      <tag>2010s</tag>
      <tag>2020s</tag>
      <tag>twin-engine</tag>
      <tag>turboprop</tag>
      <tag>retractable-gear</tag>
      <tag>propeller</tag>
      <tag>variable-pitch</tag>
      <tag>compositor</tag>
      <tag>HDR</tag>
    </tags>

  </sim>

  <payload>
    <!-- the Fuel and Payload dialog's slider (a JSBSim aircraft's are under /payload): the cabin's troops and cargo
         (the flight model's point mass 5), none at the start; up to 20000 lb, the published internal cargo limit -->
    <weight n="0">
      <name>Troops and cargo</name>
      <weight-lb alias="/fdm/jsbsim/inertia/pointmass-weight-lbs[5]"/>
      <max-lb type="double">20000</max-lb>
    </weight>
  </payload>

  <!-- the MV-22's five tanks, 1448 US gal of JP-5 in all (fdm/v22data.py), half full at the start; the engines draw
       them in the transfer sequence's order, the aft sponson first, then the forward sponsons, the feed tanks last -->
  <consumables>
    <fuel>
      <tank n="0">
        <name>Left feed</name>
      </tank>
      <tank n="1">
        <name>Right feed</name>
      </tank>
      <tank n="2">
        <name>Left forward sponson</name>
      </tank>
      <tank n="3">
        <name>Right forward sponson</name>
      </tank>
      <tank n="4">
        <name>Right aft sponson</name>
      </tank>
    </fuel>
  </consumables>

  <!-- on the ground the aircraft starts cold and dark (engines cut off, rotor brake on); in the air it starts running -->
  <fdm>
    <jsbsim>
      <eng>
        <init-running type="int">0</init-running>
      </eng>
    </jsbsim>
  </fdm>

</PropertyList>
