<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <light>
    <name>beaconlight</name>
    <!-- HDR: a spot aimed out through its lens, so that it lights the night around it and not its own skin;
         intensity in candela / 635 (the HDR unit, as the UH-60's and the Bo 105's). An anticollision light
         shines mostly sideways: the exponent of -1 makes the cone brighter toward its edge (50 cd along its axis,
         290 cd at 80 deg) -->
    <type>spot</type>
    <direction>
      <lookat-x-m> 0 </lookat-x-m>
      <lookat-y-m> 0 </lookat-y-m>
      <lookat-z-m> 1 </lookat-z-m>
    </direction>
    <color>
      <r> 1 </r>
      <g> 0.06 </g>
      <b> 0.03 </b>
    </color>
    <intensity> 0.07874 </intensity>      <!-- 50 cd -->
    <spot-exponent> -1 </spot-exponent>
    <spot-cutoff> 80 </spot-cutoff>
    <range-m> 30 </range-m>
  </light>

  <animation>
    <type>noshadow</type>
    <object-name>beaconlight</object-name>
  </animation>

  <animation>
    <type>select</type>
    <object-name>beaconlight</object-name>
    <condition>
      <!-- <property>controls/lighting/beacon</property> -->
      <property>sim/multiplay/generic/bool[11]</property>
      <!-- <property>sim/model/lights/beacon/state</property> -->
      <property>sim/multiplay/generic/bool[12]</property>
    </condition>
  </animation>

</PropertyList>
