<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <lighting>
    <instruments-norm      type="float">0.8</instruments-norm>
    <landing-lights        type="bool">false</landing-lights>
    <beacon                type="bool">false</beacon>
    <strobe                type="bool">false</strobe>
    <nav-lights            type="bool">false</nav-lights>
    <cabin-lights          type="bool">false</cabin-lights>
    <wing-lights           type="bool">false</wing-lights>
    <taxi-light            type="bool">false</taxi-light>
  </lighting>

  <electric>
    <battery-switch        type="bool">false</battery-switch>
    <avionics-switch       type="bool">false</avionics-switch>
    <generator             type="int">0</generator>
    <engines>
      <engine              n="0">
        <fuel-pump         type="bool">false</fuel-pump>
      </engine>
    </engines>
    <engines>
      <engine              n="1">
        <fuel-pump         type="bool">false</fuel-pump>
      </engine>
    </engines>
    <circuitbreaker>
      <adc                 type="bool">true</adc>
      <adf                 type="bool">true</adf>
      <ah                  type="bool">true</ah>
      <ahrs                type="bool">true</ahrs>
      <audio               type="bool">true</audio>
      <autopilot           type="bool">true</autopilot>
      <avionicbus          type="bool">true</avionicbus>
      <avionicctrl         type="bool">true</avionicctrl>
      <com1                type="bool">true</com1>
      <com2                type="bool">true</com2>
      <datalink            type="bool">true</datalink>
      <deice               type="bool">true</deice>
      <dme                 type="bool">true</dme>
      <enginstr            type="bool">true</enginstr>
      <fans                type="bool">true</fans>
      <flap                type="bool">true</flap>
      <gearctrl            type="bool">true</gearctrl>
      <gearwrn             type="bool">true</gearwrn>
      <gpsnav1             type="bool">true</gpsnav1>
      <gpsnav2             type="bool">true</gpsnav2>
      <instlight           type="bool">true</instlight>
      <landinglight        type="bool">true</landinglight>
      <leftalt             type="bool">true</leftalt>
      <leftbat             type="bool">true</leftbat>
      <leftecua            type="bool">true</leftecua>
      <leftecub            type="bool">true</leftecub>
      <leftecubus          type="bool">true</leftecubus>
      <mfd                 type="bool">true</mfd>
      <oxy                 type="bool">true</oxy>
      <pfd                 type="bool">true</pfd>
      <pitot               type="bool">true</pitot>
      <rightalt            type="bool">true</rightalt>
      <rightbat            type="bool">true</rightbat>
      <rightecua           type="bool">true</rightecua>
      <rightecub           type="bool">true</rightecub>
      <rightecubus         type="bool">true</rightecubus>
      <stallwrn            type="bool">true</stallwrn>
      <taxilight           type="bool">true</taxilight>
      <wx500               type="bool">true</wx500>
      <wxrdr               type="bool">true</wxrdr>
      <xpcom               type="bool">true</xpcom>
    </circuitbreaker>
  </electric>

  <engines>
    <engine                n="0">
      <on                  type="bool">false</on>
      <boost               type="double">1</boost>
      <magnetos            type="int">0</magnetos>
    </engine>
    <engine                n="1">
      <on                  type="bool">false</on>
      <boost               type="double">1</boost>
      <magnetos            type="int">0</magnetos>
    </engine>
  </engines>

  <rotor>
    <reltarget             type="double">1</reltarget>
    <maxreltorque          type="double">1</maxreltorque>
  </rotor>

  <rotorbrake>
    <rotorbrake-handle     type="bool">false</rotorbrake-handle>
  </rotorbrake>

  <probe>
    <position-extended     type="bool">false</position-extended>
    <position-extended-pos type="double">0</position-extended-pos>
  </probe>

  <gear>
    <brake-parking         type="bool">true</brake-parking>
    <tailwheel-lock        type="bool">true</tailwheel-lock>
  </gear>

  <flight>
    <rudder-trim           type="double"> 0.00 </rudder-trim>
    <aileron-trim          type="double"> 0.00 </aileron-trim>
    <elevator-trim         type="double"> 0.25 </elevator-trim>
  </flight>

</PropertyList>
