<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <sim                            include="views.xml">

    <startup>
      <splash-texture>Aircraft/MV-22B/v22-splash.png</splash-texture>
    </startup>

    <sound>
      <path>Aircraft/MV-22B/Sounds/v22-sound.xml</path>
      <!-- the crew alerts' voice (Nasal/alerts.nas): FlightGear's own speech, its queue apart from the radio's -->
      <voices>
        <voice n="4">
          <desc>Alerts</desc>
          <text type="string"/>
          <htsvoice type="string">cmu_us_arctic_slt.htsvoice</htsvoice>
        </voice>
      </voices>
    </sound>

    <model>
      <path                       archive="y">Aircraft/MV-22B/Models/v22.xml</path>
      <livery>
        <file                     type="string"/>
        <specular>
          <red                    type="float"> 0.03 </red>
          <green                  type="float"> 0.03 </green>
          <blue                   type="float"> 0.03 </blue>
        </specular>
        <roughness                type="float"> 0.70 </roughness>    <!-- HDR: the paint (each livery sets its own) -->
      </livery>
      <show-copilot               type="bool">false</show-copilot>
      <show-countermeasures       type="bool">false</show-countermeasures>
      <show-antennas              type="bool">false</show-antennas>
      <show-radome                type="bool">false</show-radome>
      <show-flir                  type="bool">false</show-flir>
      <show-probe                 type="bool">false</show-probe>
      <v22>
        <state                    type="int">0</state>
        <wing_state               type="int">0</wing_state>
        <blade_folding            type="float">0</blade_folding>
        <wing_rotation            type="float">0</wing_rotation>
        <tilt                     type="float">0</tilt>
        <animation_tilt           type="float">0</animation_tilt>
        <inputflaps               type="float">0</inputflaps>
        <inputtilt                type="float">0</inputtilt>
        <wingfoldincidence        type ="float">0</wingfoldincidence>
        <effects>
          <particles>
            <rotorwash>
              <enabled            type="bool">true</enabled>
              <redcombinedstart   type="float">0.3</redcombinedstart>
              <greencombinedstart type="float">0.3</greencombinedstart>
              <bluecombinedstart  type="float">0.3</bluecombinedstart>
              <redcombinedend     type="float">0.5</redcombinedend>
              <greencombinedend   type="float">0.5</greencombinedend>
              <bluecombinedend    type="float">0.5</bluecombinedend>
            </rotorwash>
            <enabled              type="bool">true</enabled>
            <redcombined          type="float">0</redcombined>
            <greencombined        type="float">0</greencombined>
            <bluecombined         type="float">0</bluecombined>
          </particles>
        </effects>
        <wing>
          <elevator               type="float">0</elevator>
          <aileron                type="float">0</aileron>
          <rudder                 type="float">0</rudder>
          <flap                   type="float">0</flap>
        </wing>
        <rotor>
          <left>
            <elevator             type="float">0</elevator>
            <collective           type="float">0</collective>
          </left>
          <right>
            <elevator             type="float">0</elevator>
            <collective           type="float">0</collective>
          </right>
        </rotor>
        <engine_right             type="float">0.0</engine_right>
        <engine_left              type="float">0.0</engine_left>
        <rotor-step-deg           type="float">-1.0</rotor-step-deg>
        <solver_throttle          type="float">0</solver_throttle>
        <wing_rotation_speed      type="float">0</wing_rotation_speed>
        <flap_speed               type="float">0</flap_speed>
        <blade_folding_speed      type="float">0</blade_folding_speed>
        <animation_tilt_speed     type="float">0</animation_tilt_speed>
        <flight_computer>
          <roll>
            <p                    type="float">1</p>
            <i                    type="float">0</i>
            <d                    type="float">1</d>
            <target_abs           type="float">0.004</target_abs>
            <target_rate          type="float">0.0015</target_rate>
            <max_i                type="float">0.5</max_i>
            <out                  type="float">0</out>
            <enabled              type="int">1</enabled>
            <last_delta           type="float">0</last_delta>
            <integral             type="float">0</integral>
          </roll>
          <pitch>
            <p                    type="float">1</p>
            <i                    type="float">0</i>
            <d                    type="float">130</d>
            <target_abs           type="float">-0.01</target_abs>
            <target_rate          type="float">0.0001</target_rate>
            <max_i                type="float">0.5</max_i>
            <out                  type="float">0</out>
            <enabled              type="int">1</enabled>
            <last_delta           type="float">0</last_delta>
            <integral             type="float">0</integral>
          </pitch>
        </flight_computer>
      </v22>
    </model>

    <systems                      include="rules.xml"/>

    <instrumentation              include="initialisation.xml"/>

    <submodels>
      <serviceable                type="bool">true</serviceable>
      <path>Aircraft/MV-22B/Models/Effects/Weapons/release.xml</path>
    </submodels>

    <multiplay>
      <chat_display>1</chat_display>
      <generic>
        <!-- Immat -->
        <int    n="0"  type="int">0</int>
        <int    n="1"  type="int">0</int>
        <int    n="2"  type="int">0</int>
        <int    n="3"  type="int">0</int>
        <int    n="4"  type="int">0</int>
        <int    n="5"  type="int">0</int>
        <!-- -->
        <int    n="6"  alias="/sim/model/v22/state"/>
        <!-- -->
        <bool   n="0"  alias="/sim/model/show-copilot"/>
        <bool   n="1"  alias="/sim/model/show-countermeasures"/>
        <bool   n="2"  alias="/sim/rendering/hdr/hdr-enabled"/>
        <bool   n="3"  alias="/sim/model/show-antennas"/>
        <bool   n="4"  alias="/sim/model/show-radome"/>
        <bool   n="5"  alias="/sim/freeze/clock"/>
        <bool   n="6"  alias="/sim/crashed"/>
        <bool   n="7"  alias="/sim/model/show-flir"/>
        <bool   n="8"  alias="/sim/model/show-probe"/>
        <!-- Lights -->
        <bool   n="11" alias="/controls/lighting/beacon"/>
        <bool   n="12" alias="/sim/model/lights/beacon/state"/>
        <bool   n="13" alias="/controls/lighting/strobe"/>
        <bool   n="14" alias="/sim/model/lights/sbc1/state"/>
        <bool   n="15" alias="/controls/lighting/nav-lights"/>
        <bool   n="16" alias="/controls/lighting/landing-lights"/>
        <bool   n="17" alias="/controls/probe/position-extended"/>
        <bool   n="18" alias="/controls/jump-signal"/>
        <!-- -->
        <bool   n="19" alias="/gear/gear[0]/wow"/>
        <bool   n="20" alias="/gear/gear[1]/wow"/>
        <bool   n="21" alias="/gear/gear[2]/wow"/>
        <!-- -->
        <float  n="0"  alias="/rotors/main/roll-deg"/>
        <float  n="1"  alias="/rotors/main/yaw-deg"/>
        <float  n="2"  alias="/sim/model/v22/engine_left"/>
        <float  n="3"  alias="/sim/model/v22/engine_right"/>
        <float  n="4"  alias="/rotors/main/blade[0]/incidence-deg"/>
        <float  n="5"  alias="/rotors/main/blade[1]/incidence-deg"/>
        <float  n="6"  alias="/rotors/main/blade[2]/incidence-deg"/>
        <float  n="7"  alias="/position/gear-agl-m"/>
        <float  n="8"  alias="/orientation/pitch-deg"/>
        <float  n="9"  alias="/orientation/roll-deg"/>
        <!-- -->
        <float  n="10" alias="/sim/model/v22/rotor/left/collective"/>
        <float  n="11" alias="/sim/model/v22/rotor/right/collective"/>
        <float  n="12" alias="/sim/model/v22/animation_tilt"/>
        <float  n="13" alias="/sim/model/v22/wing_rotation"/>
        <float  n="14" alias="/sim/model/v22/animation_tilt_speed"/>
        <!-- -->
        <float  n="15" alias="/sim/model/v22/effects/particles/rotorwash/redcombinedstart"/>
        <float  n="16" alias="/sim/model/v22/effects/particles/rotorwash/greencombinedstart"/>
        <float  n="17" alias="/sim/model/v22/effects/particles/rotorwash/bluecombinedstart"/>
        <float  n="18" alias="/sim/model/v22/effects/particles/rotorwash/redcombinedend"/>
        <float  n="19" alias="/sim/model/v22/effects/particles/rotorwash/greencombinedend"/>
        <float  n="20" alias="/sim/model/v22/effects/particles/rotorwash/bluecombinedend"/>
        <!-- -->
        <float  n="21" alias="/sim/model/v22/blade_folding"/>
        <!-- -->
        <float  n="22" alias="/gear/gear[0]/rollspeed-ms"/>
        <float  n="23" alias="/gear/gear[1]/rollspeed-ms"/>
        <float  n="24" alias="/gear/gear[2]/rollspeed-ms"/>
        <!-- Doors -->
        <float  n="25" alias="/sim/model/door-positions/crew/position-norm"/>
        <float  n="26" alias="/sim/model/door-positions/passenger/position-norm"/>
        <float  n="27" alias="/sim/model/door-positions/steps/position-norm"/>
        <float  n="28" alias="/controls/probe/position-extended-pos"/>
        <!-- -->
        <float  n="29" alias="/sim/model/turret[0]/heading"/>
        <float  n="30" alias="/sim/model/turret[0]/pitch"/>
        <!-- -->
        <float  n="31" alias="/controls/engines/engine[0]/throttle"/>
        <!-- -->
        <float  n="32" alias="/gear/gear[0]/caster-angle-deg"/>
        <!-- -->
        <float  n="33" alias="/sim/model/v22/flap_speed"/>
        <float  n="34" alias="/sim/model/v22/blade_folding_speed"/>
        <float  n="35" alias="/sim/model/v22/wing_rotation_speed"/>
        <float  n="36" alias="/rotors/gear/torque-sound-filtered"/>
        <!-- -->
        <string n="1"  alias="/sim/model/livery/texture"/>
        <!-- For Bombable -->
        <int    n="10" type="int"  alias="controls/armament/trigger"/>
        <int    n="11" type="bool" alias="controls/armament/flares-release"/>
        <string n="9"  type="string"/>
      </generic>
    </multiplay>

    <help                         include="help.xml"/>

    <flaps                        include="flaps.xml"/>

    <menubar                      include="../Dialogs/v22-menu.xml"/>

    <aircraft-data                include="aircraft-data.xml"/>

  </sim>

  <constants>
    <zero                         type="int">0</zero>
    <un                           type="int">1</un>
  </constants>

  <input                          include="v22-keyboard.xml"/>

  <controls                       include="controls.xml"/>

  <rotors                         include="rotors.xml"/>

  <surface-positions              include="surface-positions.xml"/>

  <instrumentation                include="instrumentation.xml">
    <gsdi>
      <serviceable                type="bool">true</serviceable>
      <enabled                    type="bool">true</enabled>
    </gsdi>
  </instrumentation>

  <nasal>
    <rotorwash>
      <file>Aircraft/MV-22B/Nasal/rotorwash.nas</file>
    </rotorwash>
    <doors>
      <file>Aircraft/MV-22B/Nasal/doors.nas</file>
    </doors>
    <v22>
      <file>Aircraft/MV-22B/Nasal/hdr.nas</file>
      <file>Aircraft/MV-22B/Nasal/v22.nas</file>
      <file>Aircraft/MV-22B/Nasal/light.nas</file>
      <file>Aircraft/MV-22B/Nasal/liveries.nas</file>
      <file>Aircraft/MV-22B/Nasal/interpolate.nas</file>
      <file>Aircraft/MV-22B/Nasal/convert.nas</file>
      <file>Aircraft/MV-22B/Nasal/Electrical.nas</file>
      <file>Aircraft/MV-22B/Nasal/dialogs.nas</file>
    </v22>
    <PA>
      <file>Aircraft/MV-22B/Nasal/PA.nas</file>
    </PA>
    <radar>
      <file>Aircraft/MV-22B/Nasal/radar.nas</file>
    </radar>
    <turrets>
      <file>Aircraft/MV-22B/Nasal/turrets.nas</file>
      <script>
      </script>
    </turrets>
    <alerts>
      <!-- the crew alerts: masters, sounds, acknowledgement (fdm/alerts.py, Systems/mv22b-alerts.xml) -->
      <file>Aircraft/MV-22B/Nasal/alerts.nas</file>
    </alerts>
    <displays>
      <!-- the instrument panel's displays (Models/Interior/Panel/MV22B, fdm/cockpit/panel.py) -->
      <file>Aircraft/MV-22B/Nasal/displays.nas</file>
    </displays>
    <autopilot>
      <!-- the autopilot's approach line from the ILS, VOR or route; VOR/ILS, APPR and GA (fdm/genv22.py, autopilot) -->
      <file>Aircraft/MV-22B/Nasal/autopilot.nas</file>
    </autopilot>
    <eosite>
      <!-- ENG OUT's landing sites: the runways and open ground within the glide's reach (fdm/genv22.py, eng_out_site) -->
      <file>Aircraft/MV-22B/Nasal/eosite.nas</file>
    </eosite>

    aircraft.data.add(

      "instrumentation/nav[0]/power-btn",
      "instrumentation/nav[0]/audio-btn",
      "instrumentation/nav[0]/frequencies/selected-mhz",
      "instrumentation/nav[0]/frequencies/standby-mhz",
      "instrumentation/nav[0]/to-flag",
      "instrumentation/nav[0]/from-flag",
      "instrumentation/nav[0]/radials/selected-deg",
      "instrumentation/nav[0]/gs-needle-deflection",
      "instrumentation/nav[0]/heading-needle-deflection",
      "instrumentation/nav[0]/in-range",
      "instrumentation/comm[0]/volume",
      "instrumentation/comm[0]/frequencies/selected-mhz",
      "instrumentation/comm[0]/frequencies/standby-mhz",
      "instrumentation/comm[0]/test-btn",

      "instrumentation/nav[1]/power-btn",
      "instrumentation/nav[1]/audio-btn",
      "instrumentation/nav[1]/frequencies/selected-mhz",
      "instrumentation/nav[1]/frequencies/standby-mhz",
      "instrumentation/nav[1]/to-flag",
      "instrumentation/nav[1]/from-flag",
      "instrumentation/nav[1]/radials/selected-deg",
      "instrumentation/nav[1]/gs-needle-deflection",
      "instrumentation/nav[1]/heading-needle-deflection",
      "instrumentation/nav[1]/in-range",
      "instrumentation/comm[1]/volume",
      "instrumentation/comm[1]/frequencies/selected-mhz",
      "instrumentation/comm[1]/frequencies/standby-mhz",
      "instrumentation/comm[1]/test-btn",

    );

  </nasal>

</PropertyList>
