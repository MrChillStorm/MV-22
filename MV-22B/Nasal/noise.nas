    "/environment/temperature-degc",
    "/fdm/jsbsim/eng[0]/n1-pct",
    "/fdm/jsbsim/eng[0]/running",
    "/fdm/jsbsim/eng[0]/fuel-flow-pph",
    "/fdm/jsbsim/drive/nr-pct",
    "/fdm/jsbsim/eng[0]/cranking",
    "/fdm/jsbsim/eng[1]/n1-pct",
    "/fdm/jsbsim/eng[1]/running",
    "/fdm/jsbsim/eng[1]/fuel-flow-pph",
    "/fdm/jsbsim/eng[1]/cranking",
    "/fdm/jsbsim/eng[0]/torque-pct",
    "/fdm/jsbsim/eng[1]/torque-pct",
    "/gear/gear[0]/wow",
    "/gear/gear[0]/rollspeed-ms",
    "/gear/gear[0]/compression-norm",
    "/gear/gear[1]/wow",
    "/gear/gear[1]/rollspeed-ms",
    "/gear/gear[1]/compression-norm",
    "/gear/gear[2]/wow",
    "/gear/gear[2]/rollspeed-ms",
    "/gear/gear[2]/compression-norm"
];

var _clip = func(x, lo, hi) { return x < lo ? lo : (x > hi ? hi : x); }
var _pos = func(x) { return x > 0 ? x : 0; }
var _div = func(a, b) { return b != 0 ? a / b : 0; }
# a file's A-weighted mean square at the pitch it plays at (a, its table in dB, by log2 of the pitch)
var _a = func(a, pitch) {
    var x = (math.ln(pitch) / math.ln(2) - P0) / DP;
    var k = int(_clip(x, 0, NP - 2));
    var f = _clip(x - k, 0, 1);
    return math.pow(10, 0.1 * (a[k] + f * (a[k + 1] - a[k])));
}

