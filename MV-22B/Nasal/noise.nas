var level = func {
    var p = [];
    foreach (var k; PROPS) append(p, num(getprop(k)) or 0);
    var ms = 0;
    foreach (var e; E) ms += e(p);
    return ms > 1e-30 ? 10 * math.ln(ms) / math.ln(10) : -300;
}

# the tones' gain that puts their onset TONE_OVER_DB over the cockpit's noise as played (the effects volume; the noise no
# lower than AMBIENT_DB), by the avionics volume they play at
var _vol = func(p) { var k = getprop(p); return k == nil ? 1 : _clip(k, 1e-3, 1); }
var tone_gain = func(n) {
    var db = math.max(n, AMBIENT_DB) + AIR_OUT_DB + 20 * math.ln(_vol("/sim/sound/effects/volume")) / math.ln(10) + TONE_OVER_DB;
    return _clip(math.pow(10, (db - TONE_OUT_DB) / 20) / _vol("/sim/sound/avionics/volume"), 0, 1);
}

# once a second: the noise and the tones' gain
var OUT = "/sim/model/v22/sound/";
setprop(OUT ~ "tone-gain", 1);         # until the first update: the tones at their own level, not silent
var update = func {
    var n = level();
    setprop(OUT ~ "cockpit-noise-db", n);
    setprop(OUT ~ "tone-gain", tone_gain(n));
}
var timer = maketimer(1.0, update);
setlistener("/sim/signals/fdm-initialized", func { update(); timer.start() }, 1, 0);
